                local Diameter = Radius * 2
                SilentCircle.Size     = NewUDim2(0, Diameter, 0, Diameter)
                SilentCircle.Position = NewUDim2(0.5, -Radius, 0.5, -Radius)
                SilentCircle.Visible  = true
            else
                SilentCircle.Visible = false
            end
        end)
    end

    Legit.Raycast = function(Origin, Goal, RayParams)
        local Direction      = Goal - Origin
        local DirectionUnit  = Direction.Unit
        local CurrentOrigin  = Origin
        local RemainingDist  = Direction.Magnitude

        while RemainingDist > 0 do
            local Result = Raycast(Workspace, CurrentOrigin, DirectionUnit * RemainingDist, RayParams)
            if not Result then return false end
            local HitPart = Result.Instance
            if HitPart and HitPart.CanCollide and HitPart.Transparency < 1 then return true, Result end
            RemainingDist  = RemainingDist - (Result.Position - CurrentOrigin).Magnitude
            CurrentOrigin  = Result.Position + DirectionUnit / 20
        end
        return false
    end

    Legit.TriggerbotRaycast = function(Origin, Goal, RayParams)
        local Direction      = Goal - Origin
        local DirectionUnit  = Direction.Unit
        local CurrentOrigin  = Origin
        local RemainingDist  = Direction.Magnitude

        while RemainingDist > 0 do
            local Result = Raycast(Workspace, CurrentOrigin, DirectionUnit * RemainingDist, RayParams)
            if not Result then return false end
            local HitPart = Result.Instance
            if HitPart and HitPart.Transparency < 1 then return true, Result end
            RemainingDist  = RemainingDist - (Result.Position - CurrentOrigin).Magnitude
            CurrentOrigin  = Result.Position + DirectionUnit / 20
        end
        return false
    end

    Legit.TranslatePoints = function(Points)
        local Temporary = {}
        for i = 1, #Points do
            local Group = Legit.Points[Points[i]]
            if Group then
                Move(Group, 1, #Group, #Temporary + 1, Temporary)
            end
        end
        return Temporary
    end

    Legit.GetPointScalePosition = function(Bone, Scale)
        if Scale == 0 then return Bone.Position end
        local Factor = Scale / 200
        local Size   = Legit.PointSizes[Bone.Name]
        return Bone.Position + NewVector3(
            (Random() * 2 - 1) * Size.X * Factor,
            (Random() * 2 - 1) * Size.Y * Factor,
            (Random() * 2 - 1) * Size.Z * Factor
        )
    end

    Legit.ProcessAimAssist = function(DeltaTime)
        local AssistEnabled = Flags["legit aim assist enabled"] and Flags["legit aim assist enabled"].Value
                           and Flags["legit aim assist enabled key"] and Flags["legit aim assist enabled key"].Value

        local IsMagnet = Flags["legit trigger bot magnet triggerbot"] and Flags["legit trigger bot magnet triggerbot"].Value
                      and Flags["legit trigger bot enabled"] and Flags["legit trigger bot enabled"].Value
                      and Flags["legit trigger bot enabled key"] and Flags["legit trigger bot enabled key"].Value

        if not AssistEnabled and not IsMagnet then
            Legit.CurrentTarget = nil; return
        end

        local IsMouseMode = Flags["legit aim assist mode"] and Flags["legit aim assist mode"].Value == "Mouse"

        local CameraCFrame     = CurrentCamera.CFrame
        local CameraPosition   = CameraCFrame.Position
        local CameraLookVector = CameraCFrame.LookVector

        if Legit.CurrentTarget then
            local CurrentTarget = Legit.CurrentTarget
            local CurrentPart   = CurrentTarget.Part
            local CurrentData   = CurrentTarget.Data

            if not CurrentPart or not CurrentPart.Parent then
                Legit.CurrentTarget = nil; return
            end

            if CurrentData.RootPosition and (CurrentData == Legit.PreviousTarget.Data or Tick() - Legit.PreviousTarget.Tick > (Flags["legit aim assist enemy switching delay"].Value / 1000)) then
                local AimPosition = CurrentPart.Position

                if IsMagnet or (Flags["legit aim assist wall check"] and Flags["legit aim assist wall check"].Value) then
                    local Hit = Legit.Raycast(CameraPosition, AimPosition, Legit.RayParams)
                    if Hit then Legit.CurrentTarget = nil; return end
                end

                local WeaponVelocity     = LInfo.WeaponVelocity or 300
                local WeaponAcceleration = LInfo.WeaponAcceleration or NewVector3(0, -Workspace.Gravity, 0)

                if Flags["legit aim assist adjust for target movement"] and Flags["legit aim assist adjust for target movement"].Value then
                    AimPosition = Mathematics.SolvePrediction(CameraPosition, AimPosition, CurrentPart.Velocity, WeaponVelocity)
                end
                if Flags["legit aim assist adjust for bullet drop"] and Flags["legit aim assist adjust for bullet drop"].Value then
                    AimPosition = Mathematics.SolveBulletDrop(CameraPosition, WeaponAcceleration, AimPosition, WeaponVelocity)
                end

                Legit.PreviousTarget.Data = CurrentTarget.Data
                Legit.PreviousTarget.Tick = Tick()

                local Speed = (IsMagnet and Flags["legit trigger bot magnet speed"].Value or Flags["legit aim assist speed"].Value) / 100
                local Smoothing

                if Flags["legit aim assist smoothing"] and Flags["legit aim assist smoothing"].Value == "Linear" then
                    Smoothing = Clamp(Speed * 1.5 * DeltaTime * 60, 0, 1)
                else
                    Smoothing = 1 - Exp(-Speed * 8 * DeltaTime)
                end

                if IsMouseMode then
                    local Screen, _ = Camera.WorldToViewportPoint(AimPosition, false)
                    if Screen.Z > 0 then
                        local MousePos   = UserInputService:GetMouseLocation()
                        local TargetX    = Screen.X
                        local TargetY    = Screen.Y
                        local NewMouseX  = MousePos.X + (TargetX - MousePos.X) * Smoothing
                        local NewMouseY  = MousePos.Y + (TargetY - MousePos.Y) * Smoothing
                        mousemoveabs(NewMouseX, NewMouseY)
                    end
                else
                    CurrentCamera.CFrame = CameraCFrame:Lerp(CFrame.lookAt(CameraPosition, AimPosition), Smoothing)
                end
                return
            end
            Legit.CurrentTarget = nil; return
        end

        local Enemies, EnemiesIndex = {}, 0

        if IsMouseMode then
            local MousePixelRadius = Flags["legit aim assist mouse fov radius"] and Flags["legit aim assist mouse fov radius"].Value or 80

            for i = 1, Info.PlayersIndex do
                local Data = Info.Players[i]
                local RootPosition = Data.RootPosition
                if not RootPosition or Data.IsForceField or Data.Relation == "Friendly" then continue end
                if not next(Data.BodyParts) then continue end
                local PixelDist = Legit.GetMousePixelAngle(RootPosition)
                if PixelDist and PixelDist <= MousePixelRadius then
                    EnemiesIndex += 1
                    Enemies[EnemiesIndex] = Data
                end
            end
        else
            local RadFov = Rad(IsMagnet and Flags["legit trigger bot magnet fov"].Value or Flags["legit aim assist fov"].Value)
            for i = 1, Info.PlayersIndex do
                local Data = Info.Players[i]
                local RootPosition = Data.RootPosition
                if not RootPosition or Data.IsForceField or Data.Relation == "Friendly" then continue end
                if not next(Data.BodyParts) then continue end
                if Acos(Clamp(Dot(CameraLookVector, (RootPosition - CameraPosition).Unit), -1, 1)) * 2 > RadFov then continue end
                EnemiesIndex += 1
                Enemies[EnemiesIndex] = Data
            end
        end

        if EnemiesIndex < 1 then return end

        local SelectedHitboxGroups = IsMagnet and Flags["legit trigger bot triggerbot hitboxes"].Value or Flags["legit aim assist hitscan points"].Value
        local HitscanPoints = Legit.TranslatePoints(SelectedHitboxGroups)

        local PriorityStr = IsMagnet and Flags["legit trigger bot magnet priority"].Value or Flags["legit aim assist hitscan priority"].Value
        local HitscanPriority = Legit.PriorityPartMap[PriorityStr]

        if HitscanPriority then
            local InSelected = false
            for k = 1, #HitscanPoints do
                if HitscanPoints[k] == HitscanPriority then
                    InSelected = true; break
                end
            end
            if not InSelected then HitscanPriority = nil end
        end

        local CheckWall = IsMagnet or (Flags["legit aim assist wall check"] and Flags["legit aim assist wall check"].Value)

        local Points, PointsIndex = {}, 0

        for i = 1, EnemiesIndex do
            local EnemyData      = Enemies[i]
            local EnemyBodyParts = EnemyData.BodyParts
            for k = 1, #HitscanPoints do
                local Point = EnemyBodyParts[HitscanPoints[k]]
                if not Point then continue end
                local PointPosition = Point.Position
                if CheckWall then
                    local Hit = Legit.Raycast(CameraPosition, PointPosition, Legit.RayParams)
                    if Hit then continue end
                end

                local SortMetric
                if IsMouseMode then
                    local PixelDist = Legit.GetMousePixelAngle(PointPosition)
                    SortMetric = PixelDist or Huge
                else
                    SortMetric = Acos(Clamp(Dot(CameraLookVector, (PointPosition - CameraPosition).Unit), -1, 1)) * 2
                end

                PointsIndex += 1
                Points[PointsIndex] = {
                    Part  = Point,
                    Data  = EnemyData,
                    Angle = SortMetric
                }
            end
        end

        if PointsIndex < 1 then return end

        local AccuracyCheck = (IsMagnet and Flags["legit trigger bot magnet accuracy"].Value or Flags["legit aim assist accuracy"].Value) >= Random(1, 100)

        if HitscanPriority and AccuracyCheck then
            local ClosestPriority, ClosestPriorityAngle = nil, Huge
            for i = 1, PointsIndex do
                local Point = Points[i]
                if Point.Part.Name == HitscanPriority and Point.Angle < ClosestPriorityAngle then
                    ClosestPriorityAngle = Point.Angle
                    ClosestPriority = Point
                end
            end
            if ClosestPriority then
                Legit.CurrentTarget = ClosestPriority
                Legit.CurrentTarget.Tick = Tick()
                return
            end
        end

        local ClosestPoint, ClosestAngle = nil, Huge
        for i = 1, PointsIndex do
            local Point = Points[i]
            if Point.Angle < ClosestAngle then
                ClosestAngle = Point.Angle
                ClosestPoint = Point
            end
        end
        Legit.CurrentTarget = ClosestPoint
        if Legit.CurrentTarget then Legit.CurrentTarget.Tick = Tick() end
    end

    local TriggerRayParams = RaycastParams.new()
    TriggerRayParams.FilterType         = Enum.RaycastFilterType.Include
    TriggerRayParams.RespectCanCollide  = false
    Legit.TriggerParams = TriggerRayParams

    Legit.ProcessTriggerBot = function()
        if not (Flags["legit trigger bot enabled"] and Flags["legit trigger bot enabled"].Value)
        or not (Flags["legit trigger bot enabled key"] and Flags["legit trigger bot enabled key"].Value) then return end

        local Points, PointsIndex = {}, 0
        for i = 1, Info.PlayersIndex do
            local Data = Info.Players[i]
            if not Data.RootPosition or Data.Relation == "Friendly" or Data.IsForceField then continue end
            local HitscanPoints = Legit.TranslatePoints(Flags["legit trigger bot triggerbot hitboxes"].Value)
            local BodyParts     = Data.BodyParts
            for k = 1, #HitscanPoints do
                local Point = BodyParts[HitscanPoints[k]]
                if not Point then continue end
                PointsIndex += 1
                Points[PointsIndex] = Point
            end
        end
        if PointsIndex < 1 then return end

        local CameraCFrame   = CurrentCamera.CFrame
        local CameraPosition = CameraCFrame.Position

        Legit.TriggerParams.FilterDescendantsInstances = Points
        local Hit, Result = Legit.TriggerbotRaycast(CameraPosition, CameraPosition + CameraCFrame.LookVector * 750, Legit.TriggerParams)
        if not Hit then return end

        local Hit2 = Legit.Raycast(CameraPosition, Result.Instance.Position, Legit.RayParams)
        if Hit2 then return end

        Wrap(function()
            mouse1press()
            Wait(1 / 60)
            mouse1release()
        end)()
    end

    RenderStepped:Connect(Legit.ProcessAimAssist)
    RenderStepped:Connect(Legit.ProcessTriggerBot)
end

