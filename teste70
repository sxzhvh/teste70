    local KBTitle = NewInstance("TextLabel")
    KBTitle.Parent               = KBHeader
    KBTitle.BackgroundTransparency = 1
    KBTitle.Size                 = NewUDim2(1, 0, 1, 0)
    KBTitle.Text                 = "keybinds"
    KBTitle.TextColor3           = NewRGB(200, 200, 200)
    KBTitle.TextSize             = 11
    KBTitle.Font                 = Enum.Font.GothamBold
    KBTitle.TextXAlignment       = Enum.TextXAlignment.Center
    KBTitle.ZIndex               = 902

    -- Lista de rows
    local KBList = NewInstance("Frame")
    KBList.Name             = "List"
    KBList.Parent           = KBWidget
    KBList.BackgroundTransparency = 1
    KBList.BorderSizePixel  = 0
    KBList.Size             = NewUDim2(1, 0, 1, -18)
    KBList.Position         = NewUDim2(0, 0, 0, 18)
