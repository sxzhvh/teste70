    end

    do
        local AssistCircle = Draw:Frame({Parent = Menu.Overlay, Position = NewUDim2(0,0,0,0), Size = NewUDim2(0,0,0,0), BackgroundColor3 = NewRGB(255,255,255), BackgroundTransparency = 1, ZIndex = 1000, Visible = false})
        Draw:UIStroke({Parent = AssistCircle, LineJoinMode = Enum.LineJoinMode.Round, Color = NewRGB(181,179,253), Transparency = 0, Thickness = 1})
        local c1 = NewInstance("UICorner"); c1.Parent = AssistCircle; c1.CornerRadius = UDim.new(1,0)

        local SilentCircle = Draw:Frame({Parent = Menu.Overlay, Position = NewUDim2(0,0,0,0), Size = NewUDim2(0,0,0,0), BackgroundColor3 = NewRGB(255,255,255), BackgroundTransparency = 1, ZIndex = 1000, Visible = false})
        Draw:UIStroke({Parent = SilentCircle, LineJoinMode = Enum.LineJoinMode.Round, Color = NewRGB(127,72,163), Transparency = 0, Thickness = 1})
        local c2 = NewInstance("UICorner"); c2.Parent = SilentCircle; c2.CornerRadius = UDim.new(1,0)

        local MouseCircle = Draw:Frame({Parent = Menu.Overlay, Position = NewUDim2(0,0,0,0), Size = NewUDim2(0,0,0,0), BackgroundColor3 = NewRGB(255,255,255), BackgroundTransparency = 1, ZIndex = 1000, Visible = false})
        Draw:UIStroke({Parent = MouseCircle, LineJoinMode = Enum.LineJoinMode.Round, Color = NewRGB(255,200,80), Transparency = 0, Thickness = 1})
        local c3 = NewInstance("UICorner"); c3.Parent = MouseCircle; c3.CornerRadius = UDim.new(1,0)

        RenderStepped:Connect(function()
            local IsMouseMode = Flags["legit aim assist mode"] and Flags["legit aim assist mode"].Value == "Mouse"

            if Flags["legit aim assist visualize fov"] and Flags["legit aim assist visualize fov"].Value then
                if IsMouseMode then
                    local MousePos = UserInputService:GetMouseLocation()
                    local Radius = Flags["legit aim assist mouse fov radius"] and Flags["legit aim assist mouse fov radius"].Value or 80
                    local Diameter = Radius * 2
                    MouseCircle.Size     = NewUDim2(0, Diameter, 0, Diameter)
                    MouseCircle.Position = NewUDim2(0, MousePos.X - Radius, 0, MousePos.Y - Radius)
                    MouseCircle.Visible  = true
                    AssistCircle.Visible = false
                else
                    local Radius   = (Tan(Rad(Flags["legit aim assist fov"].Value) / 2) / Tan(Rad(CurrentCamera.FieldOfView) / 2)) * (ScreenSizeY / 2)
                    local Diameter = Radius * 2
                    AssistCircle.Size     = NewUDim2(0, Diameter, 0, Diameter)
                    AssistCircle.Position = NewUDim2(0.5, -Radius, 0.5, -Radius)
                    AssistCircle.Visible  = true
                    MouseCircle.Visible   = false
