                            local Velocity = Mathematics.ResolveGrenadeVelocity(Origin, Goal, 150, Workspace.Gravity * 0.55)
                            if not Velocity then AimDot.Visible = false; return end
                            if Flags["misc grenade helper automatic aim"].Value then
                                CurrentCamera.CFrame = CurrentCamera.CFrame:Lerp(
                                    NewCFrame(CurrentCamera.CFrame.Position, CurrentCamera.CFrame.Position + Velocity.Unit),
                                    Flags["misc grenade helper speed"].Value / 10 * DeltaTime
                                )
                            end
                            local Position, OnScreen = Camera.WorldToViewportPoint(Origin + Velocity.Unit * 9999, true)
                            if OnScreen then
                                AimDot.Position = NewUDim2(0, Position.X-(AimDot.AbsoluteSize.X/2), 0, Position.Y-(AimDot.AbsoluteSize.Y/2))
                                AimDot.Visible  = true
                            else
                                AimDot.Visible = false
                            end
                        end)
                    end)()
                end
            })
            Section:CreateSlider({Name = "Maximum FOV", Flag = "misc grenade helper fov", Suffix = "°", Value = 10, Minimum = 0, Maximum = 15})
            Section:CreateToggle({Name = "Automatic aim", Flag = "misc grenade helper automatic aim"})
            Section:CreateSlider({Name = "Speed", Flag = "misc grenade helper speed", Value = 25, Minimum = 1, Maximum = 100, Suffix = "%"})
            Section:CreateToggle({Name = "Adjust for target movement", Flag = "misc grenade helper adjust for target movement"})
        end

        -- SETTINGS SECTION — com Keybind List adicionado
        local Section = Menu.Window.Pages[5]:CreateSection({Name = "Settings", Side = 2, Length = 0.5}) do
            Section:CreateColorpicker({
                Name = "Menu color", Flag = "menu color", Color = Menu.Theme["Accent"],
                Callback = function(Color) Menu:ChangeThemeColor("Accent", Color) end
            })

            -- ====================================================
            -- KEYBIND LIST toggle — adicionado acima de Lock menu layout
            -- ====================================================
            Section:CreateToggle({
                Name  = "Keybind list",
                Flag  = "misc keybind list visible",
                Value = false,
                Callback = function(Enabled)
                    KeybindList.SetVisible(Enabled)
                end
            })
            -- ====================================================

            Section:CreateToggle({Name = "Lock menu layout"})
            Section:CreateButton({Name = "Reset menu layout", Confirm = true})
        end
    end

    -- PLAYERS
    do
        local SelectedPlayerData
        local WhitelistToggle
        local PriorityToggle

        local Section = Menu.Window.Pages[7]:CreateSection({Name = "Players", Side = 1, Length = 1}) do
            local PlayersList = Section:CreateSearchList({
                Length  = 409,
                Options = {},
                Callback = function(SelectedUsername)
                    SelectedPlayerData = Info.Players[SelectedUsername]
                    if not SelectedPlayerData then return end
                    WhitelistToggle:SetValue(SelectedPlayerData.Relation == "Friendly", true)
                    PriorityToggle:SetValue(SelectedPlayerData.Relation == "Priority",  true)
                end
            })

            Section:CreateButton({Name = "Reset all", Callback = function()
                for i = 1, Info.PlayersIndex do
                    local Data = Info.Players[i]
                    Data.Relation = nil
                    WhitelistToggle:SetValue(false, true)
                    PriorityToggle:SetValue(false, true)
                end
            end})

            task.spawn(function()
                repeat Wait() until Info.Loaded
                for i = 1, Info.PlayersIndex do PlayersList:AddOption(Info.Players[i].Name) end
                PlayerAdded:Connect(function(Player) PlayersList:AddOption(Player.Name) end)
                PlayerRemoved:Connect(function(Player) PlayersList:RemoveOption(Player.Name) end)
            end)
        end

        local Section = Menu.Window.Pages[7]:CreateSection({Name = "Adjustments", Side = 2, Length = 1}) do
            WhitelistToggle = Section:CreateToggle({Name = "Add to whitelist", Callback = function(Enabled)
                if not SelectedPlayerData then return end
                SelectedPlayerData.Relation = Enabled and "Friendly" or nil
            end})
            PriorityToggle = Section:CreateToggle({Name = "High priority", Callback = function(Enabled)
                if not SelectedPlayerData then return end
                SelectedPlayerData.Relation = Enabled and "Priority" or nil
            end})
        end
    end

    -- CONFIG
    do
        local Section = Menu.Window.Pages[8]:CreateSection({Name = "Presets", Side = 1, Length = 1}) do
            local PresetList
            local PresetName

            PresetList = Section:CreateList({
                Options  = Menu:GetConfigs("Skeet/Universal/Configurations"),
                Callback = function(Name) PresetName:SetValue(Name) end
            })

            PresetName = Section:CreateTextbox()

            Section:CreateButton({Name = "Load", Confirm = true, Callback = function()
                Menu:LoadConfig("Skeet/Universal/Configurations/" .. PresetList.Value .. ".cfg")
                Menu:CreateNotification({Text = "loaded config " .. PresetList.Value .. "!", LifeTime = 5, Priority = 1})
            end})

            Section:CreateButton({Name = "Save", Confirm = true, Callback = function()
                local Path = "Skeet/Universal/Configurations/" .. PresetName.Value .. ".cfg"
                Menu:SaveConfig(Path)
                Menu:CreateNotification({Text = "saved config " .. PresetName.Value .. "!", LifeTime = 5, Priority = 1})
                if isfile(Path) then PresetList:AddOption(PresetName.Value) end
            end})

            Section:CreateButton({Name = "Delete", Confirm = true, Callback = function()
                local Path = "Skeet/Universal/Configurations/" .. PresetList.Value .. ".cfg"
                if isfile(Path) then delfile(Path); PresetList:RemoveOption(PresetList.Value) end
            end})

            Section:CreateButton({Name = "Reset", Confirm = true})
            Section:CreateButton({Name = "Import from clipboard", Confirm = true, Callback = function() Menu:ImportClipboard() end})
            Section:CreateButton({Name = "Export to clipboard", Confirm = true, Callback = function()
                Menu:ExportClipboard("Skeet/Universal/Configurations/" .. PresetList.Value .. ".cfg")
            end})
        end

        local Section = Menu.Window.Pages[8]:CreateSection({Name = "Lua", Side = 2, Length = 1}) do
            Section:CreateToggle({Name = "Enabled", Value = true})
            Section:CreateToggle({Name = "Allow unsafe scripts"})
            Section:CreateButton({Name = "Reload active scripts"})
            Section:CreateLabel({Text = "Universal build — game-independent"})
            Section:CreateToggle({Name = "Load on startup"})
            Section:CreateButton({Name = "Load script"})
        end
    end
end

