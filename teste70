    KBListLayout.VerticalAlignment   = Enum.VerticalAlignment.Top
    KBListLayout.SortOrder       = Enum.SortOrder.LayoutOrder
    KBListLayout.Padding         = UDim.new(0, 0)

    -- Drag logic
    local Dragging, DragStart, StartPos = false, nil, nil
    KBHeader.InputBegan:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1 then
            Dragging  = true
            DragStart = Input.Position
            StartPos  = KBWidget.Position
        end
    end)
    KBHeader.InputEnded:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1 then
            Dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(Input)
        if Dragging and Input.UserInputType == Enum.UserInputType.MouseMovement then
            local Delta = Input.Position - DragStart
            KBWidget.Position = NewUDim2(
                StartPos.X.Scale, StartPos.X.Offset + Delta.X,
                StartPos.Y.Scale, StartPos.Y.Offset + Delta.Y
            )
        end
    end)

    -- Tabela de mapeamento: Flag -> nome amigavel
    -- Registra os keybinds que queremos mostrar
    local KBMapping = {
        { FlagName = "legit aim assist enabled key",       DisplayName = "Aim Assist"   },
        { FlagName = "legit trigger bot enabled key",      DisplayName = "Triggerbot"   },
        { FlagName = "misc grenade helper hotkey",         DisplayName = "Grenade"      },
        { FlagName = "esp players enabled",                DisplayName = "ESP"          },
    }

    -- Pool de rows UI
    local KBRows = {}

    local function GetOrCreateRow(Index)
        if KBRows[Index] then return KBRows[Index] end

        local Row = NewInstance("Frame")
        Row.BackgroundTransparency = 1
        Row.BorderSizePixel        = 0
        Row.Size                   = NewUDim2(1, 0, 0, 16)
        Row.LayoutOrder            = Index
        Row.Parent                 = KBList
        Row.ZIndex                 = 902

        local NameLabel = NewInstance("TextLabel")
        NameLabel.Name               = "NameLabel"
        NameLabel.BackgroundTransparency = 1
        NameLabel.Size               = NewUDim2(0.5, -4, 1, 0)
