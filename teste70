    -- FIX GlyphProvider: ESP.Step so renderiza textlabels se FontsReady = true
    local LastStep = 0
    Esp.Step = function()
        local Time  = Tick()
        local Delta = Time - LastStep
        if Delta < (1 / Flags["esp esp settings refresh rate"].Value) then return end
        LastStep = Time

        if not Flags["esp players enabled"].Value then
            for i = 1, Info.PlayersIndex do
                local Renders = Info.Players[i].Renders
                Renders.Framework.Visible = false
                Renders.Arrow.Visible     = false
                for j = 1, 9 do Renders[j].Visible = false end
            end
            return
        end

        local WTVP          = Camera.WorldToViewportPoint
        local ShowBox       = Flags["esp players bounding box"].Value
        local ShowFill      = ShowBox and Flags["esp players filled bounding box"].Value
        local ShowHealth    = Flags["esp players health bar"].Value
        -- FIX GlyphProvider: so mostra text se fonts prontas
        local ShowName      = Flags["esp players name"].Value and FontsReady
        local ShowWeapon    = Flags["esp players held weapon"].Value and FontsReady
        local ShowDistance  = Flags["esp players distance"].Value and FontsReady
        local ShowSkeleton  = Flags["esp players skeleton"].Value
        local ShowRank      = Flags["esp players rank"].Value and FontsReady
        local ShowArrow     = Flags["esp players out of view"].Value

        local BoxColorpicker     = ShowBox    and Flags["esp players bounding box color"]
        local BoxFillColorpicker = ShowFill   and Flags["esp players filled bounding box color"]
        local HealthColorLow     = ShowHealth and Flags["esp players health bar color low"]
        local HealthColorHigh    = ShowHealth and Flags["esp players health bar color high"]
        local NameColorpicker    = ShowName   and Flags["esp players name color"]
        local SkeletonColorpicker = ShowSkeleton and Flags["esp players skeleton color"]
        local ArrowColorpicker   = ShowArrow  and Flags["esp players arrow color"]
        local ArrowDynamic       = ShowArrow  and Flags["esp players dynamic arrow size"].Value
        local ArrowSize          = not ArrowDynamic and Flags["esp players arrow size"].Value
        local DrawDistance       = Flags["esp esp settings maximum draw distance"].Value

        for i = 1, Info.PlayersIndex do
            local Data = Info.Players[i]

            if not Data.RootPosition or Data.Distance > DrawDistance then
                local Renders = Data.Renders
                Renders.Framework.Visible = false
                Renders.Arrow.Visible     = false
                for j = 1, 9 do Renders[j].Visible = false end
                continue
            end

            local Renders      = Data.Renders
            local RootPosition = Data.RootPosition
            local BodyParts    = Data.BodyParts

            local HeadPart    = BodyParts["Head"]
            local TorsoPart   = BodyParts["Torso"]
            local LLegPart    = BodyParts["Left Leg"]
            local RLegPart    = BodyParts["Right Leg"]

            local TopWorld, BottomWorld

            if HeadPart and TorsoPart then
                TopWorld    = HeadPart.Position + NewVector3(0, 0.6, 0)
                if LLegPart or RLegPart then
                    local LegPart = LLegPart or RLegPart
                    BottomWorld = LegPart.Position - NewVector3(0, 1.1, 0)
                else
                    BottomWorld = TorsoPart.Position - NewVector3(0, 2.2, 0)
                end
            else
                TopWorld    = RootPosition + NewVector3(0, 2.8, 0)
                BottomWorld = RootPosition - NewVector3(0, 3.2, 0)
            end

            local CharWidth = TorsoPart and (BodyPartSizes["Torso"].X * 0.6) or 1.1

            local TopLeft     = WTVP(TopWorld    + NewVector3(-CharWidth, 0, 0), false)
            local TopRight    = WTVP(TopWorld    + NewVector3( CharWidth, 0, 0), false)
            local BottomLeft  = WTVP(BottomWorld + NewVector3(-CharWidth, 0, 0), false)
            local BottomRight = WTVP(BottomWorld + NewVector3( CharWidth, 0, 0), false)

            local Position, OnScreen = WTVP(RootPosition, true)

            if not OnScreen then
                if not ShowArrow then
                    Renders.Framework.Visible = false
                    Renders.Arrow.Visible     = false
                    for j = 1, 9 do Renders[j].Visible = false end
                    continue
                end
                local Relative = PointToObjectSpace(CurrentCamera.CFrame, RootPosition)
                local Angle    = Atan2(-Relative.Y, Relative.X)
                local Rotation = Deg(Angle)
                local Radius   = 350
                local Arrow    = Renders.Arrow
                local OverridePicker = nil
                if Flags["esp esp settings highlight priorities"].Value and Data.Relation == "Priority" then
                    OverridePicker = Flags["esp esp settings highlight priorities color"]
                elseif Flags["esp esp settings highlight friendlies"].Value and Data.Relation == "Friendly" then
                    OverridePicker = Flags["esp esp settings highlight friendlies color"]
                end
                Arrow.ImageColor3     = (OverridePicker and OverridePicker.Color) or ArrowColorpicker.Color
                Arrow.ImageTransparency = ArrowColorpicker.Transparency
                Arrow.Position        = NewUDim2(0, ScreenSizeX/2 + Radius*Cos(Rad(Rotation)), 0, ScreenSizeY/2 + Radius*Sin(Rad(Rotation)))
                Arrow.Rotation        = Rotation + 90
                Arrow.Visible         = true
                local Size = ArrowDynamic and Clamp(((Data.Distance-1)/(100-1))*(7-20)+20, 7, 20) or ArrowSize
                Arrow.Size = NewUDim2(0, Size, 0, Size)
                Renders.Framework.Visible = false
                for j = 1, 9 do Renders[j].Visible = false end
                continue
            end

            local OverridePicker = nil
            if Flags["esp esp settings highlight priorities"].Value and Data.Relation == "Priority" then
                OverridePicker = Flags["esp esp settings highlight priorities color"]
            elseif Flags["esp esp settings highlight friendlies"].Value and Data.Relation == "Friendly" then
                OverridePicker = Flags["esp esp settings highlight friendlies color"]
            end

            local MinX = Min(TopLeft.X, TopRight.X, BottomLeft.X, BottomRight.X)
            local MaxX = Max(TopLeft.X, TopRight.X, BottomLeft.X, BottomRight.X)
            local MinY = Min(TopLeft.Y, TopRight.Y, BottomLeft.Y, BottomRight.Y)
            local MaxY = Max(TopLeft.Y, TopRight.Y, BottomLeft.Y, BottomRight.Y)

            local Pad  = 2
            MinX = Floor(MinX - Pad)
            MaxX = Floor(MaxX + Pad)
            MinY = Floor(MinY - Pad)
            MaxY = Floor(MaxY + Pad)

            local BoxW = Max(MaxX - MinX, 1)
            local BoxH = Max(MaxY - MinY, 1)

            local Framework = Renders.Framework
            Framework.Position = NewUDim2(0, MinX, 0, MinY)
            Framework.Size     = NewUDim2(0, BoxW, 0, BoxH)
            Framework.Visible  = true

            if ShowBox then
                local Box, BoxInline, BoxOutline, BoxFill = Renders.Box, Renders.BoxInline, Renders.BoxOutline, Renders.BoxFill
                Box.Visible         = true
                Box.Position        = NewUDim2(0, 0, 0, 0)
                Box.Size            = NewUDim2(1, 0, 1, 0)
                BoxInline.Enabled   = true
                BoxInline.Color     = (OverridePicker and OverridePicker.Color) or BoxColorpicker.Color
                BoxInline.Transparency = BoxColorpicker.Transparency
                BoxOutline.Enabled  = true
                BoxOutline.Transparency = BoxColorpicker.Transparency
                if ShowFill then
                    BoxFill.Visible = true
                    BoxFill.BackgroundColor3 = BoxFillColorpicker.Color
                    BoxFill.BackgroundTransparency = BoxFillColorpicker.Transparency
                else
                    BoxFill.Visible = false
                end
            else
                Renders.Box.Visible       = false
                Renders.BoxInline.Enabled = false
                Renders.BoxOutline.Enabled = false
            end

            if ShowHealth then
                local Percent = Clamp(Data.Health / Max(Data.MaxHealth, 1), 0, 1)
                local HealthColor = HealthColorLow.Color:Lerp(HealthColorHigh.Color, Percent)
                Renders.HealthOutline.Visible   = true
                Renders.HealthOutline.Position  = NewUDim2(0, -6, 0, 0)
                Renders.HealthOutline.Size      = NewUDim2(0, 3, 1, 0)
                Renders.HealthInline.Visible    = true
                Renders.HealthInline.Size       = NewUDim2(1, 0, Percent, 0)
                Renders.HealthInline.BackgroundColor3 = HealthColor
                Renders.HealthInline.AnchorPoint = NewVector2(0, 1)
                Renders.HealthInline.Position    = NewUDim2(0, 0, 1, 0)
            else
                Renders.HealthOutline.Visible = false
                Renders.HealthInline.Visible  = false
            end

            if ShowName then
                Renders.Name.Visible      = true
                Renders.Name.Position     = NewUDim2(0.5, 0, 0, -2)
                Renders.Name.AnchorPoint  = NewVector2(0.5, 1)
                Renders.Name.TextColor3   = (OverridePicker and OverridePicker.Color) or NameColorpicker.Color
                Renders.Name.TextTransparency = NameColorpicker.Transparency
                Renders.NameShadow.Visible = true
                Renders.NameShadow.Position = NewUDim2(0.5, 1, 0, -1)
                Renders.NameShadow.AnchorPoint = NewVector2(0.5, 1)
                Renders.NameShadow.TextTransparency = NameColorpicker.Transparency
            else
                Renders.Name.Visible      = false
                Renders.NameShadow.Visible = false
            end

            if ShowWeapon and Data.Weapon then
                Renders.Weapon.Visible  = true
                Renders.Weapon.Text     = Data.Weapon
                Renders.Weapon.Position = NewUDim2(0.5, 0, 1, 3)
                Renders.Weapon.AnchorPoint = NewVector2(0.5, 0)
            else
                Renders.Weapon.Visible = false
            end

            if ShowDistance then
                Renders.Distance.Visible   = true
                Renders.Distance.Text      = (Floor(Data.Distance * 10 + 0.5) / 10) .. "M"
                Renders.Distance.Position  = Renders.Weapon.Visible and NewUDim2(0.5, 0, 1, 14) or NewUDim2(0.5, 0, 1, 3)
                Renders.Distance.AnchorPoint = NewVector2(0.5, 0)
            else
                Renders.Distance.Visible = false
            end

            if ShowRank then
                Renders.Rank.Visible  = true
                Renders.Rank.Text     = Data.Rank
                Renders.Rank.Position = NewUDim2(1, 4, 0, 0)
                Renders.Rank.AnchorPoint = NewVector2(0, 0)
            else
                Renders.Rank.Visible = false
            end

            -- FIX SKELETON: usa index do joint pra pegar os offsets corretos
            if ShowSkeleton then
                local Joints = Data.Joints
                for j = 1, #Joints do
                    local JointData = Joints[j]
                    local OrigIdx   = JointData[3]  -- index original no SkeletonJoints
                    local PositionA = WTVP(PointToWorldSpace(JointData[1].CFrame, SkeletonOffsetsA[OrigIdx]))
                    local PositionB = WTVP(PointToWorldSpace(JointData[2].CFrame, SkeletonOffsetsB[OrigIdx]))
                    local Center    = (NewVector2(PositionA.X,PositionA.Y) + NewVector2(PositionB.X,PositionB.Y)) / 2
                    local Offset    = NewVector2(PositionB.X,PositionB.Y) - NewVector2(PositionA.X,PositionA.Y)
                    -- FIX: ignora linhas de comprimento 0 (same part)
                    if Offset.Magnitude < 1 then
                        Renders[j].Visible = false
                        continue
                    end
                    local Line      = Renders[j]
                    Line.Position        = NewUDim2(0, Center.X, 0, Center.Y)
                    Line.Size            = NewUDim2(0, Offset.Magnitude, 0, 1)
                    Line.Rotation        = Deg(Atan2(Offset.Y, Offset.X))
                    Line.BackgroundColor3 = (OverridePicker and OverridePicker.Color) or SkeletonColorpicker.Color
                    Line.Transparency    = SkeletonColorpicker.Transparency
                    Line.Visible         = true
                end
                for j = #Joints + 1, 9 do Renders[j].Visible = false end
            else
                for j = 1, 9 do Renders[j].Visible = false end
            end

            Renders.Arrow.Visible = false
        end
    end

    Esp.Load = function()
        Esp.StepConnection = RenderStepped:Connect(Esp.Step)
        Esp.Loaded = true
    end
end

