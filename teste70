        NameLabel.TextSize           = 10
        NameLabel.Font               = Enum.Font.Gotham
        NameLabel.TextXAlignment     = Enum.TextXAlignment.Left
        NameLabel.ZIndex             = 903
        NameLabel.Parent             = Row

        local KeyLabel = NewInstance("TextLabel")
        KeyLabel.Name               = "KeyLabel"
        KeyLabel.BackgroundTransparency = 1
        KeyLabel.Size               = NewUDim2(0.25, 0, 1, 0)
        KeyLabel.Position           = NewUDim2(0.5, 0, 0, 0)
        KeyLabel.TextColor3         = NewRGB(150, 200, 60)   -- cor accent
        KeyLabel.TextSize           = 10
        KeyLabel.Font               = Enum.Font.GothamBold
        KeyLabel.TextXAlignment     = Enum.TextXAlignment.Center
        KeyLabel.ZIndex             = 903
        KeyLabel.Parent             = Row

        local ModeLabel = NewInstance("TextLabel")
        ModeLabel.Name              = "ModeLabel"
        ModeLabel.BackgroundTransparency = 1
        ModeLabel.Size              = NewUDim2(0.25, -4, 1, 0)
        ModeLabel.Position          = NewUDim2(0.75, 0, 0, 0)
        ModeLabel.TextColor3        = NewRGB(130, 130, 130)
        ModeLabel.TextSize          = 9
        ModeLabel.Font              = Enum.Font.Gotham
        ModeLabel.TextXAlignment    = Enum.TextXAlignment.Center
        ModeLabel.ZIndex            = 903
        ModeLabel.Parent            = Row

        KBRows[Index] = {Frame = Row, Name = NameLabel, Key = KeyLabel, Mode = ModeLabel}
        return KBRows[Index]
    end

    -- Converte enum key pra string legivel
    local function KeyName(Key)
        if not Key then return "?" end
        local Name = tostring(Key)
        Name = GSub(Name, "Enum.KeyCode.", "")
        Name = GSub(Name, "Enum.UserInputType.", "")
        -- Simplifica nomes comuns
        local Short = {
            LeftMouseButton = "LMB", RightMouseButton = "RMB",
            MouseButton1 = "LMB", MouseButton2 = "RMB",
            LeftShift = "LShift", RightShift = "RShift",
            LeftControl = "LCtrl", RightControl = "RCtrl",
            LeftAlt = "LAlt", RightAlt = "RAlt",
        }
        return Short[Name] or Name
    end

    -- Converte modo do hotkey pra texto curto
    local function ModeName(Mode)
        if not Mode then return "" end
        local Short = {
            ["Always on"]  = "Always",
            ["On hotkey"]  = "Hold",
            ["Toggle"]     = "Toggle",
            ["Hold"]       = "Hold",
        }
        return Short[Mode] or Mode
    end

    -- Atualiza o widget com as keybinds ativas
    local function UpdateKeybindWidget()
        local ActiveCount = 0

        for i, Entry in ipairs(KBMapping) do
            local Flag = Flags[Entry.FlagName]
            if not Flag then continue end

            -- Detecta se tem key
            local Key  = Flag.Key
            local Mode = Flag.Mode or "Hold"

            -- Pula se nao tem key configurada
            if not Key then continue end

            ActiveCount += 1
            local Row = GetOrCreateRow(ActiveCount)
            Row.Frame.Visible   = true
            Row.Frame.LayoutOrder = ActiveCount
            Row.Name.Text       = Entry.DisplayName
            Row.Key.Text        = "[" .. KeyName(Key) .. "]"
            Row.Mode.Text       = ModeName(Mode)
        end

        -- Esconde rows extras
        for i = ActiveCount + 1, #KBRows do
            KBRows[i].Frame.Visible = false
        end

        -- Atualiza tamanho do widget
        local HeaderH  = 18
        local RowH     = 16
        local PadBot   = 4
        local TotalH   = HeaderH + (ActiveCount * RowH) + PadBot
        KBWidget.Size  = NewUDim2(0, 190, 0, Max(TotalH, 24))
    end

    -- Expoe API
    KeybindList.Widget       = KBWidget
    KeybindList.Update       = UpdateKeybindWidget
    KeybindList.SetVisible   = function(V)
        KBWidget.Visible = V
        if V then UpdateKeybindWidget() end
    end

    -- Update periodico das keybinds (a cada 0.5s)
    task.spawn(function()
        while true do
            Wait(0.5)
            if KBWidget.Visible then
                UpdateKeybindWidget()
            end
        end
    end)
end

