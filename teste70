-- ============================================================
-- BULLET TRACERS & HIT EFFECTS SYSTEM
-- ============================================================
local TracerSystem = {}
local HitEffectSystem = {}

do
    local TracerPool   = {}
    local TracerActive = {}

    local TRACER_LIFETIME    = 0.35
    local TRACER_FADE_TIME   = 0.25
    local TRACER_THICKNESS   = 0.08
    local TRACER_LIGHT_RANGE = 20
    local TRACER_LIGHT_BRIGHT= 2

    local function GetTracerPart()
        if #TracerPool > 0 then
            return Remove(TracerPool)
        end
        local Part = NewInstance("Part")
        Part.Anchored      = true
        Part.CanCollide    = false
        Part.CanTouch      = false
        Part.CastShadow    = false
        Part.Locked        = true
        Part.Material      = Enum.Material.Neon
        Part.Shape         = Enum.PartType.Cylinder
        Part.Size          = NewVector3(1, TRACER_THICKNESS, TRACER_THICKNESS)
        Part.Parent        = Workspace
        local Light = NewInstance("PointLight")
        Light.Brightness   = TRACER_LIGHT_BRIGHT
        Light.Range        = TRACER_LIGHT_RANGE
        Light.Shadows      = false
        Light.Parent       = Part
        return Part
    end

    local function ReturnTracerPart(Part)
        Part.Transparency = 1
        Part.Size         = NewVector3(0.01, 0.01, 0.01)
        local Light = FindFirstChildOfClass(Part, "PointLight")
        if Light then Light.Enabled = false end
        Insert(TracerPool, Part)
    end

    function TracerSystem.Spawn(Origin, Impact, Color)
        if not Flags["visuals bullet tracers enabled"] then return end
        if not Flags["visuals bullet tracers enabled"].Value then return end

        local TracerColor = Color or (Flags["visuals bullet tracers color"] and Flags["visuals bullet tracers color"].Color) or NewRGB(255, 100, 50)

        local Part = GetTracerPart()
        local Direction   = Impact - Origin
        local Length      = Direction.Magnitude
        local MidPoint    = Origin + Direction * 0.5
        local Thickness   = (Flags["visuals bullet tracers thickness"] and Flags["visuals bullet tracers thickness"].Value or 6) / 100

        Part.Size         = NewVector3(Length, Thickness, Thickness)
        Part.CFrame       = NewCFrame(MidPoint, Impact) * CFrame.Angles(0, math.pi / 2, 0)
        Part.Color        = TracerColor
        Part.Transparency = 0.1
        Part.Parent       = Workspace

        local Light = FindFirstChildOfClass(Part, "PointLight")
        if Light then
            Light.Color     = TracerColor
            Light.Enabled   = true
            Light.Brightness = TRACER_LIGHT_BRIGHT
            Light.Range      = TRACER_LIGHT_RANGE
        end

        local Entry = {Part = Part, SpawnTime = Tick(), Lifetime = TRACER_LIFETIME, FadeTime = TRACER_FADE_TIME}
        Insert(TracerActive, Entry)
    end

    local Tracer2DLines = {}

    function TracerSystem.Spawn2D(Origin, Impact, Color)
        if not Flags["visuals bullet tracers enabled"] then return end
        if not Flags["visuals bullet tracers enabled"].Value then return end
        if not Flags["visuals bullet tracers 2d overlay"] then return end
        if not Flags["visuals bullet tracers 2d overlay"].Value then return end

        local TracerColor = Color or (Flags["visuals bullet tracers color"] and Flags["visuals bullet tracers color"].Color) or NewRGB(255, 100, 50)

        local OriginScreen, OriginOnScreen = Camera.WorldToViewportPoint(Origin, false)
        local ImpactScreen, ImpactOnScreen = Camera.WorldToViewportPoint(Impact, false)

        if OriginScreen.Z <= 0 and ImpactScreen.Z <= 0 then return end

        local AX = OriginScreen.X
        local AY = OriginScreen.Y
        local BX = ImpactScreen.X
        local BY = ImpactScreen.Y

        local DX = BX - AX
        local DY = BY - AY
        local Len = Sqrt(DX * DX + DY * DY)
        if Len < 1 then return end

        local Cx = (AX + BX) / 2
        local Cy = (AY + BY) / 2

        local Line = NewInstance("Frame")
        Line.AnchorPoint         = NewVector2(0.5, 0.5)
        Line.BorderSizePixel     = 0
        Line.BackgroundColor3    = TracerColor
        Line.BackgroundTransparency = 0
        Line.Size                = NewUDim2(0, Len, 0, 1)
        Line.Position            = NewUDim2(0, Cx, 0, Cy)
        Line.Rotation            = Deg(Atan2(DY, DX))
        Line.Parent              = Menu.Overlay
        Line.ZIndex              = 500

        local Glow = NewInstance("UIGradient")
        Glow.Rotation    = 0
        Glow.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0,   0),
            NumberSequenceKeypoint.new(0.5, 0.4),
            NumberSequenceKeypoint.new(1,   0),
        })
        Glow.Parent = Line

        Insert(Tracer2DLines, {Frame = Line, SpawnTime = Tick(), Lifetime = TRACER_LIFETIME, FadeTime = TRACER_FADE_TIME})
    end

    function TracerSystem.Step()
        local Now = Tick()

        for i = #TracerActive, 1, -1 do
            local Entry = TracerActive[i]
            local Age   = Now - Entry.SpawnTime

            if Age >= Entry.Lifetime then
                local FadeAge = Age - Entry.Lifetime
                local Alpha   = Clamp(FadeAge / Entry.FadeTime, 0, 1)

                Entry.Part.Transparency = Alpha
                local Light = FindFirstChildOfClass(Entry.Part, "PointLight")
                if Light then Light.Brightness = TRACER_LIGHT_BRIGHT * (1 - Alpha) end

                if Alpha >= 1 then
                    ReturnTracerPart(Entry.Part)
                    Remove(TracerActive, i)
                end
            end
        end

        for i = #Tracer2DLines, 1, -1 do
            local Entry = Tracer2DLines[i]
            local Age   = Now - Entry.SpawnTime

            if Age >= Entry.Lifetime then
                local FadeAge = Age - Entry.Lifetime
                local Alpha   = Clamp(FadeAge / Entry.FadeTime, 0, 1)
                Entry.Frame.BackgroundTransparency = Alpha
                if Alpha >= 1 then
                    Destroy(Entry.Frame)
                    Remove(Tracer2DLines, i)
                end
            end
        end
    end

    local HitActive = {}
    local HIT_EFFECT_DURATION = 0.4

    function HitEffectSystem.Spawn(HitPosition, HitInstance)
        if not Flags["visuals hit effects enabled"] then return end
        if not Flags["visuals hit effects enabled"].Value then return end

        local HitColor = (Flags["visuals hit effects color"] and Flags["visuals hit effects color"].Color) or NewRGB(255, 30, 30)
        local HitSize  = (Flags["visuals hit effects size"] and Flags["visuals hit effects size"].Value or 50)

        local LightPart = NewInstance("Part")
        LightPart.Anchored    = true
        LightPart.CanCollide  = false
        LightPart.CanTouch    = false
        LightPart.Transparency = 1
        LightPart.Size        = NewVector3(0.1, 0.1, 0.1)
        LightPart.Position    = HitPosition
        LightPart.Parent      = Workspace

        local Burst = NewInstance("PointLight")
        Burst.Color      = HitColor
        Burst.Range      = 15
        Burst.Brightness = 5
        Burst.Shadows    = false
        Burst.Parent     = LightPart

        local ScreenPos, OnScreen = Camera.WorldToViewportPoint(HitPosition, true)
        local RingFrame = nil

        if OnScreen or ScreenPos.Z > 0 then
            local StartSize = HitSize * 0.5

            local Outer = NewInstance("Frame")
            Outer.AnchorPoint       = NewVector2(0.5, 0.5)
            Outer.BackgroundTransparency = 1
            Outer.BorderSizePixel   = 0
            Outer.Size              = NewUDim2(0, StartSize, 0, StartSize)
            Outer.Position          = NewUDim2(0, ScreenPos.X, 0, ScreenPos.Y)
            Outer.ZIndex            = 600
            Outer.Parent            = Menu.Overlay

            local Ring = NewInstance("UIStroke")
            Ring.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
            Ring.Color           = HitColor
            Ring.Transparency    = 0
            Ring.Thickness       = 2
            Ring.Parent          = Outer

            local Corner = NewInstance("UICorner")
            Corner.CornerRadius = UDim.new(1, 0)
            Corner.Parent       = Outer

            local Dot = NewInstance("Frame")
            Dot.AnchorPoint          = NewVector2(0.5, 0.5)
            Dot.BackgroundColor3     = HitColor
            Dot.BackgroundTransparency = 0.3
            Dot.BorderSizePixel      = 0
            Dot.Size                 = NewUDim2(0, StartSize * 0.3, 0, StartSize * 0.3)
            Dot.Position             = NewUDim2(0.5, 0, 0.5, 0)
            Dot.ZIndex               = 601
            Dot.Parent               = Outer

            local DotCorner = NewInstance("UICorner")
            DotCorner.CornerRadius = UDim.new(1, 0)
            DotCorner.Parent       = Dot

            RingFrame = {Outer = Outer, Ring = Ring, Dot = Dot, StartSize = StartSize, HitSize = HitSize}
        end

        local DmgLabel = nil
        if Flags["visuals hit effects damage numbers"] and Flags["visuals hit effects damage numbers"].Value then
            if OnScreen or (ScreenPos.Z and ScreenPos.Z > 0) then
                local Label = NewInstance("TextLabel")
                Label.AnchorPoint       = NewVector2(0.5, 0.5)
                Label.BackgroundTransparency = 1
                Label.TextColor3        = HitColor
                Label.TextStrokeColor3  = NewRGB(0, 0, 0)
                Label.TextStrokeTransparency = 0.4
                Label.FontFace          = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Bold, Enum.FontStyle.Normal)
                Label.TextSize          = 14
                Label.Text              = "HIT"
                Label.Position          = NewUDim2(0, ScreenPos.X, 0, ScreenPos.Y - HitSize * 0.5 - 8)
                Label.Size              = NewUDim2(0, 60, 0, 16)
                Label.ZIndex            = 602
                Label.Parent            = Menu.Overlay
                DmgLabel = Label
            end
        end

        Insert(HitActive, {
            SpawnTime  = Tick(),
            Duration   = HIT_EFFECT_DURATION,
            LightPart  = LightPart,
            Burst      = Burst,
            RingFrame  = RingFrame,
            DmgLabel   = DmgLabel,
            HitPosition = HitPosition,
        })
    end

    function HitEffectSystem.Step()
        local Now = Tick()

        for i = #HitActive, 1, -1 do
            local Entry  = HitActive[i]
            local Age    = Now - Entry.SpawnTime
            local Alpha  = Clamp(Age / Entry.Duration, 0, 1)
            local InvAlpha = 1 - Alpha

            if Entry.Burst then
                Entry.Burst.Brightness = 5 * InvAlpha
            end

            if Entry.RingFrame then
                local RF = Entry.RingFrame
                local CurrentSize = RF.StartSize + (RF.HitSize - RF.StartSize) * Alpha
                RF.Outer.Size = NewUDim2(0, CurrentSize, 0, CurrentSize)
                RF.Ring.Transparency  = Alpha
                RF.Dot.BackgroundTransparency = 0.3 + 0.7 * Alpha

                local ScreenPos, OnScreen = Camera.WorldToViewportPoint(Entry.HitPosition, true)
                if OnScreen or (ScreenPos.Z and ScreenPos.Z > 0) then
                    RF.Outer.Position = NewUDim2(0, ScreenPos.X, 0, ScreenPos.Y)
                    if Entry.DmgLabel then
                        Entry.DmgLabel.Position = NewUDim2(0, ScreenPos.X, 0, ScreenPos.Y - CurrentSize * 0.5 - 8)
                    end
                end
            end

            if Entry.DmgLabel then
                Entry.DmgLabel.TextTransparency = Alpha
                Entry.DmgLabel.TextStrokeTransparency = 0.4 + 0.6 * Alpha
            end

            if Alpha >= 1 then
                Destroy(Entry.LightPart)
                if Entry.RingFrame then
                    Destroy(Entry.RingFrame.Outer)
                end
                if Entry.DmgLabel then
                    Destroy(Entry.DmgLabel)
                end
                Remove(HitActive, i)
            end
        end
    end

    RenderStepped:Connect(function()
        TracerSystem.Step()
        HitEffectSystem.Step()
    end)
end

-- ============================================================
-- UNIVERSAL WEAPON DETECTION
-- ============================================================
do
    local OldFireServer = FireServer
    local RealFireServer = hookfunction(OldFireServer, newcclosure(function(Remote, ...)
        local Args = {...}

        if Flags["visuals bullet tracers enabled"] and Flags["visuals bullet tracers enabled"].Value then
            local Origin, Direction

            for i = 1, #Args do
                local Arg = Args[i]
                local ArgType = typeof(Arg)

                if ArgType == "Vector3" and not Origin then
                    Origin = Arg
                elseif ArgType == "Vector3" and Origin and not Direction then
                    Direction = Arg
                elseif ArgType == "CFrame" and not Origin then
                    Origin    = Arg.Position
                    Direction = Arg.LookVector
                elseif ArgType == "table" then
                    if typeof(Arg.Origin) == "Vector3" then Origin = Arg.Origin end
                    if typeof(Arg.Direction) == "Vector3" then Direction = Arg.Direction end
                    if typeof(Arg.Position) == "Vector3" then Origin = Arg.Position end
                    if typeof(Arg.Target) == "Vector3" then Direction = (Arg.Target - (Origin or NewVector3())).Unit end
                end
            end

            if Origin and Direction then
                local RayResult = Workspace:Raycast(Origin, Direction * 2000)
                local Impact = RayResult and RayResult.Position or (Origin + Direction * 500)

                local TracerColor = Flags["visuals bullet tracers color"] and Flags["visuals bullet tracers color"].Color or NewRGB(255, 120, 40)
                TracerSystem.Spawn(Origin, Impact, TracerColor)
                TracerSystem.Spawn2D(Origin, Impact, TracerColor)

                if RayResult and Flags["visuals hit effects enabled"] and Flags["visuals hit effects enabled"].Value then
                    local HitInstance = RayResult.Instance
                    if HitInstance then
                        local HitChar = HitInstance:FindFirstAncestorOfClass("Model")
                        if HitChar then
                            local HitHumanoid = FindFirstChildOfClass(HitChar, "Humanoid")
                            if HitHumanoid and HitChar ~= LocalPlayer.Character then
                                HitEffectSystem.Spawn(RayResult.Position, HitInstance)
                            end
                        end
                    end
                end
            end
        end

        return OldFireServer(Remote, ...)
    end))

    local function WatchHumanoid(Data)
        if not Data.Humanoid then return end
        Data.Humanoid.HealthChanged:Connect(function(NewHealth)
            if not Flags["visuals hit effects enabled"] then return end
            if not Flags["visuals hit effects enabled"].Value then return end
            if Data.Health == nil then return end
            if NewHealth < Data.Health and Data.Health > 0 then
                if Data.RootPosition then
                    HitEffectSystem.Spawn(Data.RootPosition + NewVector3(0, 1.5, 0), nil)
                end
            end
        end)
    end

    Env.SpawnTracer    = TracerSystem.Spawn
    Env.SpawnHitEffect = HitEffectSystem.Spawn
end

-- Debug helpers
local function SafeWaitForChild(Parent, Timeout, Name)
    if not Parent then return nil end
    local Object = WaitForChild(Parent, Name, Timeout)
    if Object then return Object end
    return nil
end

local function GetTableIndexes(Table)
    local Indexes = {}
    local IndexesIndex = 0
    for Index, _ in next, Table do
        IndexesIndex += 1
        Indexes[IndexesIndex] = Index
    end
    return Indexes, IndexesIndex
end

