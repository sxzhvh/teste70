    Esp.CreateChams = function(Player)
        local Chams = {}
        local Names = BodyPartNames
        for i = 1, #Names do
            local PartName = Names[i]
            local PartSize = BodyPartSizes[PartName]
            local IsHead   = PartName == "Head"
            local ChamSet  = {}
            for k = 1, 2 do
                local Inline = (k == 1)
                local Cham
                if IsHead then
                    local Sub = Inline and 0.4 or 0.3
                    Cham = NewInstance("CylinderHandleAdornment")
                    Cham.Parent = Menu.Overlay
                    Cham.CFrame = NewCFrame(NewVector3(), NewVector3(0,1,0))
                    Cham.Height = PartSize.Y + 0.4 - Sub
                    Cham.Radius = PartSize.X / 2 - Sub
                else
                    Cham = NewInstance("BoxHandleAdornment")
                    Cham.Parent = Menu.Overlay
                    Cham.Size   = PartSize + (Inline and NewVector3(-0.1,-0.1,-0.1) or NewVector3(0.1,0.1,0.1))
                end
                Cham.ZIndex        = 1
                Cham.AlwaysOnTop   = Inline
                ChamSet[k] = Cham
            end
            Chams[PartName] = ChamSet
        end
        return Chams
    end

    -- FIX CHAMS: UpdateChamsPlayer com guards completos
    Esp.UpdateChamsPlayer = function(Data, Visible)
        if not Data or not Data.Chams then return end
        if not Visible then
            for _, Value in next, Data.Chams do
                if Value[1] then Value[1].Visible = false end
                if Value[2] then Value[2].Visible = false end
            end
            return
        end
        -- FIX: guard completo para todas as flags de cor
        local VisibleColorpicker =
            (Data.Relation == "Priority"
                and Flags["esp esp settings highlight priorities"]
                and Flags["esp esp settings highlight priorities"].Value
                and Flags["esp esp settings highlight priorities color"])
            or (Data.Relation == "Friendly"
                and Flags["esp esp settings highlight friendlies"]
                and Flags["esp esp settings highlight friendlies"].Value
                and Flags["esp esp settings highlight friendlies color"])
            or Flags["esp players chams visible color"]

        local InvisibleColorpicker = Flags["esp players chams invisible color"]

        -- FIX: se colorpickers nao existem ainda, sai silenciosamente
        if not VisibleColorpicker or not InvisibleColorpicker then return end

        local InvisibleColor, InvisibleTransparency = InvisibleColorpicker.Color, InvisibleColorpicker.Transparency
        local VisibleColor, VisibleTransparency     = VisibleColorpicker.Color, VisibleColorpicker.Transparency

        -- FIX: guard para flags de shade/glow
        local GlowFlag  = Flags["esp players glow"]
        local Glow      = GlowFlag and GlowFlag.Value or false
        local InlineShadeFlag  = Flags["esp players chams shade invisible"]
        local OutlineShadeFlag = Flags["esp players chams shade visible"]
        local InlineShade   = Enum.AdornShading[InlineShadeFlag and InlineShadeFlag.Value or "Default"]
        local OutlineShade  = Enum.AdornShading[OutlineShadeFlag and OutlineShadeFlag.Value or "Default"]

        for Index, Value in next, Data.Chams do
            local BodyPart = Data.BodyParts[Index]
            local Inline, Outline = Value[1], Value[2]
            if not Inline or not Outline then continue end
            Inline.Adornee    = BodyPart
            Inline.Transparency = InvisibleTransparency
            Inline.Color3     = InvisibleColor
            Inline.AlwaysOnTop = true
            Inline.Visible    = BodyPart ~= nil
            Inline.Shading    = InlineShade
            Outline.Adornee   = BodyPart
            Outline.Transparency = VisibleTransparency
            Outline.Color3    = VisibleColor
            Outline.ZIndex    = Glow and -1 or 1
            Outline.AlwaysOnTop = Glow
            Outline.Visible   = BodyPart ~= nil
            Outline.Shading   = OutlineShade
        end
