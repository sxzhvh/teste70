do
    local Garbage = getgc(true)
    for i = 1, #Garbage do
        local Current = Garbage[i]
        if typeof(Current) == "table" and typeof(rawget(Current, "spring")) == "table" then
            local SpringModule = rawget(Current, "spring")
            if typeof(rawget(SpringModule, "new")) == "function" then
                local OldNewSpring = SpringModule.new
                SpringModule.new = function(...)
                    local Spring = OldNewSpring(...)
                    if SFind(Traceback(), "LoadGun", 1, true) or SFind(Traceback(), "Gun", 1, true) then
                        local OldAccelerate = Spring.accelerate
                        Spring.accelerate = function(Self, Impulse)
                            if Flags["recoil scale"] and Flags["recoil scale"].Value then
                                Impulse = NewVector3(
                                    Impulse.X * (Flags["recoil scale pitch"] and Flags["recoil scale pitch"].Value or 100) / 100,
                                    Impulse.Y * (Flags["recoil scale yaw"]   and Flags["recoil scale yaw"].Value   or 100) / 100,
                                    Impulse.Z
                                )
                            end
                            return OldAccelerate(Self, Impulse)
                        end
                    end
                    return Spring
                end
                break
            end
        end
    end
    Garbage = nil
end

