-- FIX CHAMS: BodyParts populate independente do estado de chams
-- FIX CHAMS: guard em UpdateChamsPlayer para Flags existir
-- ============================================================
do
    Info.Players      = {}
    Info.PlayersIndex = 0
    Info.LastSort     = 0

    Info.AddPlayer = function(Player)
        local Data = {
            Player    = Player,
            Name      = Player.Name,
            IsForceField = false,
            Joints    = {},
            BodyParts = {},
            Relation  = nil,
            Health    = 0,
            MaxHealth = 100,
            Distance  = 0,
            Weapon    = nil,
            Rank      = 1,
            Chams     = Esp.CreateChams(Player),
            Renders   = Esp.AddPlayer(Player)
        }

        Data.OnSpawn = function(Character)
            Data.Character = Character
            Data.Humanoid  = WaitForChild(Character, "Humanoid", Infinite)
            Data.RootPart  = WaitForChild(Character, "HumanoidRootPart", Infinite)
            Data.Health    = Data.Humanoid.Health
            Data.MaxHealth = Data.Humanoid.MaxHealth

            Data.Character.ChildAdded:Connect(function(Child)
                local ClassName = Child.ClassName
                if ClassName == "Tool" then
                    Data.Weapon = Child.Name
                elseif ClassName == "ForceField" then
                    Data.IsForceField = true
                elseif ClassName == "Part" and BodyPartList[Child.Name] then
                    Data.BodyParts[Child.Name] = Child
                    Data.UpdateJoints()
                    -- FIX: guard - só atualiza chams se flag existe e está ativa
                    if Flags["esp players chams"] and Flags["esp players chams"].Value then
                        local ChamSet = Data.Chams[Child.Name]
                        if ChamSet then
                            ChamSet[1].Adornee = Child
                            ChamSet[2].Adornee = Child
                        end
                    end
                end
            end)

            Data.Character.ChildRemoved:Connect(function(Child)
                if not Data.Character then return end
                local ClassName = Child.ClassName
                if ClassName == "Tool" then
                    Data.Weapon = nil
                elseif ClassName == "ForceField" and not FindFirstChildOfClass(Data.Character, "ForceField") then
                    Data.IsForceField = false
                elseif ClassName == "Part" and Data.BodyParts[Child.Name] then
                    Data.BodyParts[Child.Name] = nil
                    Data.UpdateJoints()
                end
            end)

            Data.Character.AncestryChanged:Connect(function(Character, Parent)
                if Parent == nil then
                    Data.Character   = nil
                    Data.Humanoid    = nil
                    Data.RootPart    = nil
                    Data.Health      = 0
                    Data.RootCFrame  = nil
                    Data.RootPosition = nil
                    Data.Weapon      = nil
                    Data.Distance    = 0
                    Data.Joints      = {}
                    Data.BodyParts   = {}
                end
            end)

            Data.Humanoid.HealthChanged:Connect(function()
                if Data.Humanoid then
                    Data.Health    = Data.Humanoid.Health
                    Data.MaxHealth = Data.Humanoid.MaxHealth
                end
            end)

            Data.Humanoid.Died:Connect(function()
                Data.Character   = nil
                Data.Humanoid    = nil
                Data.RootPart    = nil
                Data.Health      = 0
                Data.RootCFrame  = nil
                Data.RootPosition = nil
                Data.Weapon      = nil
                Data.Distance    = 0
                Data.Joints      = {}
                Data.BodyParts   = {}
            end)

            -- FIX CHAMS: scan incondicional de todos os filhos
            local Children = GetChildren(Data.Character)
            for i = 1, #Children do
                local Child     = Children[i]
                local ClassName = Child.ClassName
                if ClassName == "Tool" then
                    Data.Weapon = Child.Name
                elseif ClassName == "ForceField" then
                    Data.IsForceField = true
                elseif ClassName == "Part" and BodyPartList[Child.Name] then
                    Data.BodyParts[Child.Name] = Child
                end
            end

            Data.UpdateJoints()

            -- FIX CHAMS: guard para flag existir antes de chamar UpdateChams
            if Flags["esp players chams"] then
                Esp.UpdateChamsPlayer(Data, Flags["esp players chams"].Value)
            end

            if Flags["visuals hit effects enabled"] and Flags["visuals hit effects enabled"].Value then
                local LastHealth = Data.Health
                Data.Humanoid.HealthChanged:Connect(function(NewHealth)
                    if NewHealth < LastHealth and Data.RootPosition then
                        HitEffectSystem.Spawn(Data.RootPosition + NewVector3(0, 1.5, 0), nil)
                    end
                    LastHealth = NewHealth
                end)
            end
        end

        Data.UpdateJoints = function()
            Data.Joints = {}
            for i = 1, #SkeletonJoints do
                local PartA = Data.BodyParts[SkeletonJoints[i][1]]
                local PartB = Data.BodyParts[SkeletonJoints[i][2]]
                -- FIX SKELETON: nao adiciona joint se as duas parts sao identicas
                if PartA and PartB and PartA ~= PartB then
                    Data.Joints[#Data.Joints + 1] = {PartA, PartB, i}
                end
            end
        end

        Data.OnSpawnConnection = Player.CharacterAdded:Connect(Data.OnSpawn)
        if Player.Character then Data.OnSpawn(Player.Character) end

        Info.PlayersIndex += 1
        Info.Players[Info.PlayersIndex] = Data
        Info.Players[Player]            = Data
        Info.Players[Player.Name]       = Data

        return Data
    end

    Info.RemovePlayer = function(Player)
        local Data = Info.Players[Player]
        if not Data then return end

        for _, Render in next, Data.Renders do Destroy(Render) end
        for _, Cham in next, Data.Chams do
            Destroy(Cham[1])
            Destroy(Cham[2])
        end

        Info.Players[Player]      = nil
        Info.Players[Player.Name] = nil

        for i = 1, Info.PlayersIndex do
            if Info.Players[i] == Data then
                Remove(Info.Players, i)
                Info.PlayersIndex -= 1
                break
            end
        end
    end

    Info.Step = function()
        local DistanceOrigin = LInfo.RootPart and LInfo.RootPart.Position
        local PlayersList    = Info.Players
        local PlayersIndex   = Info.PlayersIndex

        for i = 1, PlayersIndex do
            local Data = PlayersList[i]
            if Data.Humanoid and Data.RootPart then
                Data.RootCFrame   = Data.RootPart.CFrame
                Data.RootPosition = Data.RootPart.Position
                if DistanceOrigin then
                    Data.Distance = (DistanceOrigin - Data.RootPosition).Magnitude
                end
            end
        end

        local Time = Tick()
        if Time - Info.LastSort > 0.5 then
            for i = 1, PlayersIndex - 1 do
                local Player1 = PlayersList[i]
                local Rank1   = (Player1.Relation == "Priority" and 2) or 1
                for j = i + 1, PlayersIndex do
                    local Player2 = PlayersList[j]
                    local Rank2   = (Player2.Relation == "Priority" and 2) or 1
                    if Rank1 < Rank2 then
                        PlayersList[i], PlayersList[j] = PlayersList[j], PlayersList[i]
                        Rank1   = Rank2
                        Player1 = PlayersList[i]
                    end
                end
            end
            Info.LastSort = Time
        end
    end

    Info.Load = function()
        local PlayerList = Players:GetPlayers()
        for i = 1, #PlayerList do
            if PlayerList[i] ~= LocalPlayer then
                Info.AddPlayer(PlayerList[i])
            end
        end
        PlayerAdded:Connect(function(Player)
            if Player ~= LocalPlayer then Info.AddPlayer(Player) end
        end)
        PlayerRemoved:Connect(Info.RemovePlayer)
        Stepped:Connect(Info.Step)
        Info.Loaded = true
    end
end

